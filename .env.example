# Base URL used to build canonical links and Open Graph image URLs.
# Point this at the Netlify preview while the custom domain isn't live yet,
# then switch it to https://xtendyourselfsalon.com once DNS is cut over.
SITE_URL=https://xtendyourselfsalon.netlify.app

# Optional: GA4 Measurement ID (e.g. G-XXXXXXXXXX). Leave unset to disable
# analytics entirely — Analytics.tsx no-ops when this isn't provided.
NEXT_PUBLIC_GA_ID=
